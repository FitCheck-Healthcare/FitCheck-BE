# macOS는 기본적으로 5000 포트를 AirPlay Receiver가 사용합니다.
PORT=5001
SUPABASE_URL=https://your-project.supabase.co
# Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Dashboard → Settings → Database → Connection string (URI, Session pooler)
# 특수문자(@ 등) 비밀번호는 SUPABASE_DB_PASSWORD 로 별도 설정 권장
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres
SUPABASE_DB_PASSWORD=your_database_password

# 네이버 검색 API (developers.naver.com > Application > 검색)
# 지역 검색(local) API 사용 — Client Secret은 서버 전용, 프론트에 노출 금지
NAVER_SEARCH_CLIENT_ID=your_naver_search_client_id
NAVER_SEARCH_CLIENT_SECRET=your_naver_search_client_secret

# 상담 신청 PII 필드 암호화 (AES-256-GCM)
# 생성: openssl rand -base64 32
ENCRYPTION_KEY=your_32_byte_base64_encryption_key
# 전화번호 HMAC 조회용 pepper (openssl rand -base64 32)
PHONE_HMAC_PEPPER=your_phone_hmac_pepper

# 식단 사진 AI 분석 (Google AI Studio API Key — https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key
# 선택. 기본값 gemini-flash-latest (신규 API 키는 gemini-2.5-flash 등 고정 버전 404 가능)
# GEMINI_MODEL=gemini-flash-latest
